# sed-Skript fuer sysconfig.h (#undef NAME -> #define NAME WERT)
rm -f config.hsed
: > config.hsed
while read name value
do
  test -z "$name" && continue
  esc=`echo "$value" | sed -e 's/\\\\/\\\\\\\\/g' -e 's/[&|]/\\\\&/g'`
  echo "s|^#undef $name[ ]*\$|#define $name $esc|" >> config.hsed
done < config.defs

# gespeicherte Argumente fuer "config.status --recheck"
echo "$saved_args" > config.args

cleanup_conftest

# ------------------------------------------------------------- config.status
cat > config.status <<'EOF_STATUS'
#! /bin/sh
# config.status - vom schlanken E-UAE-configure erzeugt (AmigaOS 4.1).
# Aufruf: sh ./config.status [Datei ...] | --recheck | depfiles
LC_ALL=C
export LC_ALL
topdir=`pwd`

case $1 in
  --recheck)
    saved=`cat config.args`
    eval "set x $saved"
    shift
    echo "running ${CONFIG_SHELL-/bin/sh} ./configure $* (--recheck)"
    exec ${CONFIG_SHELL-/bin/sh} ./configure "$@"
    ;;
  --version)
    echo "E-UAE config.status (schlank, AmigaOS 4.1)"
    exit 0
    ;;
esac

everything=no
if test $# -eq 0; then
  everything=yes
  files=`cat config.files`
else
  files="$*"
fi

# --- Dateien aus *.in erzeugen --------------------------------------------
for f in $files
do
  case $f in
    depfiles|--*) continue ;;
  esac
  if test ! -f "$f.in"; then
    echo "config.status: $f.in nicht vorhanden - uebersprungen"
    continue
  fi
  case $f in
    */*) dir=`echo "$f" | sed 's,/[^/]*$,,'` ;;
    *)   dir=. ;;
  esac
  if test "$dir" = "."; then
    tsd=.
    tbp=
    asd=$topdir
  else
    tsd=`echo "$dir" | sed 's,[^/][^/]*,..,g'`
    tbp=$tsd/
    asd=$topdir/$dir
  fi
  echo "config.status: creating $f"
  test "$dir" != "." && mkdir -p "$dir"
  rm -f "$f.tmp"
  sed -f config.sed \
      -e "s|@srcdir@|.|g" \
      -e "s|@top_srcdir@|$tsd|g" \
      -e "s|@top_builddir@|$tsd|g" \
      -e "s|@top_build_prefix@|$tbp|g" \
      -e "s|@builddir@|.|g" \
      -e "s|@abs_srcdir@|$asd|g" \
      -e "s|@abs_builddir@|$asd|g" \
      -e "s|@abs_top_srcdir@|$topdir|g" \
      -e "s|@abs_top_builddir@|$topdir|g" \
      -e "s|@configure_input@|Generated from $f.in by config.status.|g" \
      "$f.in" > "$f.tmp" && mv "$f.tmp" "$f"
done

# --- Header ---------------------------------------------------------------
do_header=$everything
for f in $files
do
  case $f in
    src/sysconfig.h|src/include/config.h) do_header=yes ;;
  esac
done
if test "$do_header" = yes; then
  echo "config.status: creating src/include/config.h and src/sysconfig.h"
  mkdir -p src/include
  echo "/* confdefs.h */" > src/include/config.h
  while read name value
  do
    test -z "$name" && continue
    echo "#define $name $value" >> src/include/config.h
  done < config.defs
  if test -f src/sysconfig.h.in; then
    sed -f config.hsed src/sysconfig.h.in | sed 's|^#undef \(.*\)$|/* #undef \1 */|' > src/sysconfig.h.tmp
    {
      echo "/* src/sysconfig.h.  Generated from sysconfig.h.in by config.status.  */"
      cat src/sysconfig.h.tmp
    } > src/sysconfig.h
    rm -f src/sysconfig.h.tmp
  else
    echo "config.status: WARNING: src/sysconfig.h.in fehlt - sysconfig.h wird direkt aus den Defines erzeugt"
    {
      echo "/* src/sysconfig.h (ohne Vorlage erzeugt) */"
      while read name value
      do
        test -z "$name" && continue
        echo "#define $name $value"
      done < config.defs
    } > src/sysconfig.h
  fi
fi

# --- Links ----------------------------------------------------------------
if test "$everything" = yes; then
  while read dest src
  do
    test -z "$dest" && continue
    if test ! -e "$src" && test ! -d "$src"; then
      echo "config.status: WARNING: $src existiert nicht (Link $dest)"
    fi
    rel=`echo "$src" | sed 's,^src/,,'`
    echo "config.status: linking $src to $dest"
    rm -rf "$dest"
    ln -s "$rel" "$dest" 2>/dev/null || cp -r "$src" "$dest"
  done < config.links
fi

exit 0
EOF_STATUS

# ----------------------------------------------------------------- erzeugen
echo "configure: creating ./config.status"
${CONFIG_SHELL-/bin/sh} ./config.status || exit 1

# --------------------------------------------------------------- src/tools
# Original: AC_CONFIG_SUBDIRS(src/tools), bei Cross-Compile von Hand.
if test -f src/tools/configure; then
  echo "configure: running src/tools/configure"
  if test "$UAE_TOOLS_CONFIGURE" = skip; then
    echo "  (uebersprungen: UAE_TOOLS_CONFIGURE=skip)"
  elif test "$cross_compiling" = yes; then
    ( CC=$CC_FOR_BUILD; CFLAGS=$CFLAGS_FOR_BUILD; LDFLAGS=$LDFLAGS_FOR_BUILD
      LIBS=$LIBS_FOR_BUILD; export CC CFLAGS LDFLAGS LIBS
      cd src/tools && ${CONFIG_SHELL-/bin/sh} ./configure --cache-file=/dev/null ) || {
      echo "configure: error: src/tools/configure ist fehlgeschlagen"; exit 1; }
  else
    saved_args_tools="--cache-file=/dev/null"
    ( cd src/tools && eval "${CONFIG_SHELL-/bin/sh} ./configure $saved_args_tools $var_args" ) || {
      echo "configure: error: src/tools/configure ist fehlgeschlagen"
      echo "           (siehe src/tools/config.log; ggf. UAE_TOOLS_CONFIGURE=skip setzen)"
      exit 1; }
  fi
else
  echo "configure: WARNING: src/tools/configure nicht gefunden - Host-Tools werden nicht konfiguriert"
fi

# ------------------------------------------------------------- Zusammenfassung
echo
echo "configure: ================================================================"
echo "  E-UAE $VERSION  -  $host"
echo "  Compiler:   $CC"
echo "  GUI:        $GUI_DEP    Sound: $SND_DEP    Joystick: $JOY_DEP"
echo "  JIT:        $WANT_JIT    AGA: $WANT_AGA    FPU: $WANT_FPU"
echo "  CD-ROM:     $WANT_CDIMAGE    CD32: $WANT_CD32"
echo "  CFLAGS:     $CFLAGS"
echo "  LIBS:       $LIBS"
echo "configure: ================================================================"
echo
echo "Jetzt: make"
exit 0
