#! /bin/sh
#
# configure - schlankes, handgeschriebenes configure fuer E-UAE mit
#             ReAction-GUI auf AmigaOS 4.1 (PPC, SDK / gcc).
#
# Ersetzt das mit Autoconf 2.71 erzeugte configure (liegt unveraendert als
# "configure.autoconf-2.71" daneben). Bewusst nur klassische Bourne-Shell-
# Syntax: kein $(...), kein $((...)), kein [[ ]], kein printf, kein
# Re-Exec mit anderer Shell, keine X11/SDL/GTK/pthread-Suche.
#
# Aufruf:   sh configure LIBS=-lamiga
# Optionen: --disable-jit --disable-aga --disable-fpu --disable-debugger
#           --disable-state-saving --disable-enforcer --disable-action-replay
#           --disable-xarcade --disable-ui --disable-audio --disable-fdi
#           --disable-cycle-exact-cpu --disable-compatible-cpu
#           --disable-cdimage   (CD-ROM-Images / uaescsi.device)
#           --prefix=DIR  --with-version-tag=TAG
#           CC=... CFLAGS=... CPPFLAGS=... LDFLAGS=... LIBS=... AR=... RANLIB=...
#           UAE_GUI_DEP=gui-muirexx   (statt ReAction die MUIRexx-GUI)

PACKAGE_NAME=E-UAE
PACKAGE_TARNAME=e-uae
PACKAGE_VERSION=2.0.0
UAE_VERSION_MAJOR=2
UAE_VERSION_MINOR=0
UAE_VERSION_REVISION=0
UAE_VERSION_TAG=

LC_ALL=C
export LC_ALL

# ---------------------------------------------------------------- Argumente
prefix=/usr/local
exec_prefix=
host_alias=
user_cflags=no
user_cxxflags=no
var_args=
saved_args=
unknown_opts=

for arg
do
  # Argumente fuer "config.status --recheck" sicher quoten
  echo "s/'/'\"'\"'/g" > conftest.sed
  qarg=`echo "$arg" | sed -f conftest.sed`
  saved_args="$saved_args '$qarg'"
  rm -f conftest.sed

  case $arg in
    --host=*)   host_alias=`echo "$arg" | sed 's/^[^=]*=//'` ;;
    --build=*|--target=*) ;;
    --prefix=*) prefix=`echo "$arg" | sed 's/^[^=]*=//'` ;;
    --exec-prefix=*) exec_prefix=`echo "$arg" | sed 's/^[^=]*=//'` ;;
    --with-version-tag=*) UAE_VERSION_TAG=`echo "$arg" | sed 's/^[^=]*=//'` ;;
    --cache-file=*|--srcdir=*|--bindir=*|--libdir=*|--datadir=*|--mandir=*) ;;
    --enable-*|--disable-*)
      opt=`echo "$arg" | sed -e 's/^--[a-z]*-//' -e 's/=.*$//' -e 's/-/_/g'`
      case $arg in
        --disable-*|*=no) val=no ;;
        *) val=yes ;;
      esac
      eval "enable_$opt=$val"
      ;;
    --help|-h)
      sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    --version|-V)
      echo "E-UAE configure (schlank, AmigaOS 4.1) fuer $PACKAGE_NAME $PACKAGE_VERSION"
      exit 0 ;;
    *=*)
      name=`echo "$arg" | sed 's/=.*$//'`
      val=`echo "$arg" | sed 's/^[^=]*=//'`
      case $name in
        CC|CXX|CFLAGS|CXXFLAGS|CPPFLAGS|LDFLAGS|LIBS|AR|RANLIB|STRIP|UAE_GUI_DEP|CC_FOR_BUILD|CFLAGS_FOR_BUILD|LDFLAGS_FOR_BUILD|LIBS_FOR_BUILD)
          eval "$name=\"\$val\""
          case $name in
            CFLAGS) user_cflags=yes ;;
            CXXFLAGS) user_cxxflags=yes ;;
          esac
          case $name in
            UAE_GUI_DEP) ;;
            *) var_args="$var_args '$qarg'" ;;
          esac
          ;;
        *) unknown_opts="$unknown_opts $arg" ;;
      esac
      ;;
    *) unknown_opts="$unknown_opts $arg" ;;
  esac
done

if test -z "$exec_prefix"; then
  exec_prefix='${prefix}'
fi

# ------------------------------------------------------------------ Quelltree
srcdir=`echo "$0" | sed 's,/*[^/]*$,,'`
test -z "$srcdir" && srcdir=.
if test "$srcdir" != "."; then
  echo "configure: error: dieses configure unterstuetzt nur Builds im Quelltree"
  echo "           (bitte im E-UAE-Verzeichnis mit 'sh configure' aufrufen)"
  exit 1
fi
if test ! -d src; then
  echo "configure: error: Verzeichnis src/ nicht gefunden - bitte im E-UAE-Quellbaum ausfuehren"
  exit 1
fi

rm -f config.log config.defs
echo "This file contains any messages produced by compilers while" > config.log
echo "running configure, to aid debugging if configure makes a mistake." >> config.log
: > config.defs

# Hilfsfunktionen ----------------------------------------------------------
define () {
  echo "$1 $2" >> config.defs
}

upcase () {
  echo "$1" | sed 'y,abcdefghijklmnopqrstuvwxyz/.-,ABCDEFGHIJKLMNOPQRSTUVWXYZ___,'
}

# try_compile EXTRA-FLAGS  (Quelle liegt in conftest.c)
try_compile () {
  rm -f conftest.o
  echo "configure: $CC $CFLAGS $CPPFLAGS $1 -c conftest.c" >> config.log
  $CC $CFLAGS $CPPFLAGS $1 -c conftest.c -o conftest.o >> config.log 2>&1
}

# try_link LIBS-FLAGS  (Quelle liegt in conftest.c)
try_link () {
  rm -f conftest conftest.o
  echo "configure: $CC $CFLAGS $CPPFLAGS $LDFLAGS conftest.c -o conftest $1 $LIBS" >> config.log
  $CC $CFLAGS $CPPFLAGS $LDFLAGS conftest.c -o conftest $1 $LIBS >> config.log 2>&1
}

cleanup_conftest () {
  rm -f conftest conftest.c conftest.o conftest.sed conftest.exe
}

# check_header HEADER [VORAB-INCLUDE]
check_header () {
  echo "checking for $1... $ECHO_C"
  if test -n "$2"; then
    echo "#include <$2>" > conftest.c
  else
    : > conftest.c
  fi
  echo "#include <$1>" >> conftest.c
  echo "int main (void) { return 0; }" >> conftest.c
  if try_compile ""; then
    echo "yes"
    define "HAVE_`upcase $1`" 1
    eval "have_hdr_`echo $1 | sed 'y,/.-,___,'`=yes"
  else
    echo "no"
  fi
  cleanup_conftest
}

check_func () {
  echo "checking for $1... $ECHO_C"
  cat > conftest.c <<EOF
char $1 (void);
int main (void) { return $1 (); }
EOF
  if try_link ""; then
    echo "yes"
    define "HAVE_`upcase $1`" 1
  else
    echo "no"
  fi
  cleanup_conftest
}

ECHO_C=
# "echo -n" ist auf alten Shells nicht ueberall verfuegbar: wir geben das
# Ergebnis einfach in eigener Zeile aus.

# ------------------------------------------------------------ Host / Target
host_cpu=powerpc
host_vendor=unknown
host_os=amigaos
if test -n "$host_alias"; then
  case $host_alias in
    *-*-*) host_cpu=`echo "$host_alias" | sed 's/-.*$//'`
           host_vendor=`echo "$host_alias" | sed 's/^[^-]*-\([^-]*\)-.*$/\1/'`
           host_os=`echo "$host_alias" | sed 's/^[^-]*-[^-]*-//'` ;;
    *-*)   host_cpu=`echo "$host_alias" | sed 's/-.*$//'`
           host_os=`echo "$host_alias" | sed 's/^[^-]*-//'` ;;
  esac
fi
host=$host_cpu-$host_vendor-$host_os
build=$host
target=$host

case $host_os in
  amigaos*|morphos*|aros*) ;;
  *)
    echo "configure: WARNING: Host '$host' ist kein AmigaOS - dieses configure"
    echo "           ist nur fuer AmigaOS 4.1/PPC gedacht (ReAction-GUI)."
    ;;
esac
case $host_cpu in
  powerpc|ppc) ;;
  *) echo "configure: WARNING: CPU '$host_cpu' ist nicht PowerPC" ;;
esac

echo "checking build system type... $build"
echo "checking host system type... $host"

# ------------------------------------------------------------------ Compiler
if test -z "$CC"; then
  CC=gcc
fi
if test -z "$CXX"; then
  CXX=g++
fi
if test "$user_cflags" = no; then
  CFLAGS="-g -O2"
fi
if test "$user_cxxflags" = no; then
  CXXFLAGS="-g -O2"
fi

set x $CC
ccbin=$2
ccprefix=`echo "$ccbin" | sed -n 's/^\(.*-\)g*cc$/\1/p'`
if test -z "$AR"; then
  AR=${ccprefix}ar
  $AR --version > /dev/null 2>&1 || AR=ar
fi
if test -z "$RANLIB"; then
  RANLIB=${ccprefix}ranlib
  $RANLIB --version > /dev/null 2>&1 || RANLIB=ranlib
fi
if test -z "$STRIP"; then
  STRIP=${ccprefix}strip
  $STRIP --version > /dev/null 2>&1 || STRIP=strip
fi

cross_compiling=no
if test -n "$CC_FOR_BUILD"; then
  cross_compiling=yes
fi

echo "checking whether the C compiler ($CC) works..."
cat > conftest.c <<'EOF'
int main (void) { return 0; }
EOF
if try_link ""; then
  echo "  yes"
else
  echo "configure: error: C-Compiler '$CC' kann keine Programme erzeugen"
  echo "           (LIBS='$LIBS')  - letzte Zeilen aus config.log:"
  tail -n 15 config.log 2>/dev/null
  cleanup_conftest
  exit 1
fi
cleanup_conftest
OBJEXT=o
EXEEXT=

# GCC-Version (nur Compile-Tests, es wird nichts ausgefuehrt)
HAVE_GCC27=no
echo "checking for GCC 2.7 or higher..."
cat > conftest.c <<'EOF'
#if defined(__GNUC__) && ((__GNUC__ > 2) || (__GNUC__ == 2 && __GNUC_MINOR__ >= 7))
int main (void) { return 0; }
#else
#error not gcc 2.7
#endif
EOF
if try_compile ""; then
  echo "  yes"
  HAVE_GCC27=yes
else
  echo "  no"
  echo "configure: WARNING: UAE may not compile and run correctly with your compiler"
fi
cleanup_conftest

# --------------------------------------------------- Endianness / Datentypen
echo "checking for big endian byte order..."
cat > conftest.c <<'EOF'
#if defined(__BIG_ENDIAN__) || defined(_BIG_ENDIAN) || (defined(__BYTE_ORDER__) && defined(__ORDER_BIG_ENDIAN__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__)
int main (void) { return 0; }
#else
#error not big endian
#endif
EOF
if try_compile ""; then
  echo "  yes"
  bigendian=yes
  define WORDS_BIGENDIAN 1
else
  echo "  no"
  bigendian=no
fi
cleanup_conftest

# sizeof per Compile-Test (funktioniert auch beim Cross-Compile)
check_sizeof () {
  # $1 = Typ, $2 = Makroname
  size=0
  for n in 1 2 4 8 16
  do
    cat > conftest.c <<EOF
typedef $1 uae_conf_t;
int uae_conf_a[sizeof (uae_conf_t) == $n ? 1 : -1];
int main (void) { return 0; }
EOF
    if try_compile ""; then
      size=$n
      break
    fi
  done
  cleanup_conftest
  echo "checking size of $1... $size"
  define "$2" $size
}
check_sizeof "char" SIZEOF_CHAR
check_sizeof "short" SIZEOF_SHORT
check_sizeof "int" SIZEOF_INT
check_sizeof "long" SIZEOF_LONG
check_sizeof "long long" SIZEOF_LONG_LONG
define SIZEOF___INT64 0
check_sizeof "void *" SIZEOF_VOID_P

# ------------------------------------------------------------------- Header
echo "checking for ANSI C header files... yes"
define STDC_HEADERS 1
define RETSIGTYPE void

for h in stdio.h stdlib.h string.h inttypes.h stdint.h strings.h sys/stat.h \
         sys/types.h unistd.h wchar.h
do
  check_header $h
done
for h in dirent.h fcntl.h sys/ioctl.h sys/time.h utime.h values.h ncurses.h \
         curses.h sys/termios.h sys/ipc.h sys/shm.h sys/mman.h \
         sys/filio.h libraries/cybergraphics.h cybergraphx/cybergraphics.h \
         devices/ahi.h libraries/mpega.h proto/mpega.h sys/soundcard.h machine/soundcard.h sun/audioio.h \
         sys/audioio.h machine/joystick.h byteswap.h
do
  check_header $h
done

echo "checking for amigainput/amigainput.h..."
cat > conftest.c <<'EOF'
#include <amigainput/amigainput.h>
int main (void) { return 0; }
EOF
if try_compile ""; then
  echo "  yes"
  HAVE_AMIGAINPUT=yes
  define HAVE_AMIGAINPUT_AMIGAINPUT_H 1
else
  echo "  no"
  HAVE_AMIGAINPUT=no
fi
cleanup_conftest

echo "checking for stdbool.h that conforms to C99..."
cat > conftest.c <<'EOF'
#include <stdbool.h>
bool uae_conf_b = true;
int main (void) { return uae_conf_b ? 0 : 1; }
EOF
if try_compile ""; then
  echo "  yes"
  define HAVE__BOOL 1
  define HAVE_STDBOOL_H 1
else
  echo "  no"
fi
cleanup_conftest

echo "checking whether time.h and sys/time.h may both be included..."
cat > conftest.c <<'EOF'
#include <sys/types.h>
#include <sys/time.h>
#include <time.h>
int main (void) { return 0; }
EOF
if try_compile ""; then
  echo "  yes"
  define TIME_WITH_SYS_TIME 1
else
  echo "  no"
fi
cleanup_conftest

echo "checking for struct stat.st_blocks..."
cat > conftest.c <<'EOF'
#include <sys/types.h>
#include <sys/stat.h>
int main (void) { struct stat s; s.st_blocks = 0; return (int) s.st_blocks; }
EOF
if try_compile ""; then
  echo "  yes"
  define HAVE_STRUCT_STAT_ST_BLOCKS 1
  define HAVE_ST_BLOCKS 1
else
  echo "  no"
fi
cleanup_conftest

echo "checking for unsigned long long..."
cat > conftest.c <<'EOF'
unsigned long long uae_conf_ull = 1ULL;
int main (void) { return (int) uae_conf_ull - 1; }
EOF
if try_compile ""; then
  echo "  yes"
  define HAVE_UNSIGNED_LONG_LONG 1
else
  echo "  no"
fi
cleanup_conftest

echo "checking for uintmax_t..."
have_uintmax=no
for h in inttypes.h stdint.h
do
  cat > conftest.c <<EOF
#include <$h>
uintmax_t uae_conf_um = 1;
int main (void) { return (int) uae_conf_um - 1; }
EOF
  if try_compile ""; then
    echo "  yes ($h)"
    define "HAVE_`upcase $h`_WITH_UINTMAX" 1
    test "$have_uintmax" = yes || define HAVE_UINTMAX_T 1
    have_uintmax=yes
  fi
  cleanup_conftest
done

echo "checking for working utime(file, NULL)... assumed yes"
define HAVE_UTIME_NULL 1

echo "checking for inline..."
ac_cv_c_inline=
for kw in inline __inline__ __inline
do
  cat > conftest.c <<EOF
static $kw int uae_conf_f (void) { return 0; }
int main (void) { return uae_conf_f (); }
EOF
  if try_compile ""; then
    ac_cv_c_inline=$kw
    break
  fi
done
cleanup_conftest
test -z "$ac_cv_c_inline" && ac_cv_c_inline=
echo "  $ac_cv_c_inline"

# ----------------------------------------------------------------- Funktionen
for f in gettimeofday sigaction select strerror isnan isinf setitimer alarm \
         sync readdir_r strdup strstr strcasecmp stricmp strcmpi nanosleep \
         usleep sleep vprintf vsprintf vfprintf localtime_r timegm gmtime_r
do
  check_func $f
done

for b in 16 32
do
  echo "checking for bswap_$b..."
  cat > conftest.c <<EOF
#ifdef HAVE_BYTESWAP_H
# include <byteswap.h>
#endif
int main (void) { bswap_$b (1); return 0; }
EOF
  if test "x$have_hdr_byteswap_h" = xyes; then
    echo '#define HAVE_BYTESWAP_H 1' > conftest.h
    cat conftest.h conftest.c > conftest.c.new && mv conftest.c.new conftest.c
    rm -f conftest.h
  fi
  if try_link ""; then
    echo "  yes"
    define "HAVE_BSWAP_$b" 1
  else
    echo "  no"
  fi
  cleanup_conftest
done

# -------------------------------------------------------- Dateisystem-Nutzung
for h in sys/param.h sys/vfs.h sys/fs_types.h sys/statfs.h sys/statvfs.h
do
  check_header $h
done
check_header sys/mount.h sys/param.h

echo "checking how to get filesystem space usage..."
fsusage=none
for inc in sys/vfs.h sys/mount.h
do
  if test "$fsusage" = none; then
    cat > conftest.c <<EOF
#include <sys/types.h>
#include <$inc>
int main (void) { struct statfs fsd; fsd.f_bsize = 0; return statfs (".", &fsd); }
EOF
    if try_link ""; then
      fsusage=STAT_STATFS2_BSIZE
    fi
    cleanup_conftest
  fi
done
if test "$fsusage" = none; then
  cat > conftest.c <<'EOF'
#include <sys/types.h>
#include <sys/statvfs.h>
int main (void) { struct statvfs fsd; return statvfs (".", &fsd); }
EOF
  if try_link ""; then
    fsusage=STAT_STATVFS
  fi
  cleanup_conftest
fi
echo "  $fsusage"
if test "$fsusage" != none; then
  define $fsusage 1
else
  echo "configure: WARNING: keine statfs/statvfs-Variante gefunden (fsusage.c)"
fi

# ----------------------------------------------------------------- libz / dl
echo "checking for inflateEnd in -lz..."
cat > conftest.c <<'EOF'
char inflateEnd (void);
int main (void) { return inflateEnd (); }
EOF
if try_link "-lz"; then
  zlib_cv_libz=yes
else
  zlib_cv_libz=no
fi
cleanup_conftest
echo "  $zlib_cv_libz"
echo "checking for zlib.h..."
cat > conftest.c <<'EOF'
#include <zlib.h>
int main (void) { return 0; }
EOF
if try_compile ""; then
  zlib_cv_zlib_h=yes
else
  zlib_cv_zlib_h=no
fi
cleanup_conftest
echo "  $zlib_cv_zlib_h"
if test "$zlib_cv_libz" != yes || test "$zlib_cv_zlib_h" != yes; then
  echo "configure: error: libz bzw. zlib.h nicht gefunden (SDK: libz installiert?)"
  exit 1
fi
UAE_LIBS="-lz"

echo "checking for dlopen in -ldl..."
cat > conftest.c <<'EOF'
char dlopen (void);
int main (void) { return dlopen (); }
EOF
if try_link "-ldl"; then
  echo "  yes"
  UAE_LIBS="-ldl $UAE_LIBS"
  define HAVE_DLOPEN 1
else
  echo "  no"
fi
cleanup_conftest

# --------------------------------------------------------------- Optionen
# Standardwerte wie im Original-configure.in fuer AmigaOS/PPC
want () {
  # want NAME DEFAULT -> liefert yes/no
  eval "w=\$enable_$1"
  if test -z "$w"; then
    w=$2
  fi
  echo "$w"
}
WANT_AGA=`want aga yes`
WANT_JIT=`want jit yes`
WANT_FPU=`want fpu yes`
WANT_COMPATIBLE=`want compatible_cpu yes`
WANT_CYCLEEXACT=`want cycle_exact_cpu yes`
WANT_DEBUGGER=`want debugger yes`
WANT_STATESAVING=`want state_saving yes`
WANT_ENFORCER=`want enforcer yes`
WANT_ACTION_REPLAY=`want action_replay yes`
WANT_XARCADE=`want xarcade yes`
WANT_UI=`want ui yes`
WANT_AUDIO=`want audio yes`
WANT_FDI=`want fdi yes`
WANT_AUTOCONFIG=`want autoconfig yes`
WANT_BSDSOCK=`want bsdsock yes`
WANT_CDIMAGE=`want cdimage yes`
WANT_CD32=`want cd32 yes`

for o in $unknown_opts
do
  echo "configure: WARNING: Option '$o' wird von diesem schlanken configure ignoriert"
done
for o in cdtv threads optimization profiling dga vidmode
do
  eval "v=\$enable_$o"
  if test -n "$v"; then
    echo "configure: WARNING: --enable/disable-$o wird ignoriert (AmigaOS-Standard wird verwendet)"
  fi
done

UAE_DEFINES=
UAE_CFLAGS=
UAE_CPPFLAGS=
UAE_CXXFLAGS=
CPUOBJS='cpuemu_0.$(OBJEXT)'
JITOBJS=
DEBUGOBJS=
FILESYSOBJS=
SCSIOBJS='scsi-none.$(OBJEXT)'
CDOBJS=
BSDSOCKOBJS='bsdsocket.$(OBJEXT)'
EXTRAOBJS='writelog.$(OBJEXT)'
RESOBJS=
ASMOBJS=
UAE_RSRCFILE=
NO_SCHED_CFLAGS=
GENCPUOPTS=
MATHLIB=-lm

# CPU-Emulation
UAE_DEFINES="$UAE_DEFINES -DCPUEMU_0"
if test "$WANT_COMPATIBLE" != no; then
  UAE_DEFINES="$UAE_DEFINES -DCPUEMU_5"
  CPUOBJS="$CPUOBJS cpuemu_5.\$(OBJEXT)"
fi
if test "$WANT_CYCLEEXACT" != no; then
  UAE_DEFINES="$UAE_DEFINES -DCPUEMU_6"
  CPUOBJS="$CPUOBJS cpuemu_6.\$(OBJEXT)"
fi
if test "$WANT_FPU" != no; then
  UAE_DEFINES="$UAE_DEFINES -DFPUEMU"
  CPUOBJS="$CPUOBJS fpp.\$(OBJEXT)"
fi

# Compiler-Flags
OPTIMIZE_CFLAGS=
if test "$HAVE_GCC27" = yes; then
  GENCPUOPTS="--optimized-flags"
  echo "checking whether $CC accepts -fomit-frame-pointer..."
  echo 'int main (void) { return 0; }' > conftest.c
  if try_compile "-fomit-frame-pointer"; then
    echo "  yes"
    OPTIMIZE_CFLAGS="-fomit-frame-pointer"
  else
    echo "  no"
  fi
  cleanup_conftest
  WARNING_CFLAGS="-Wall -Wno-unused -Wno-format -W -Wmissing-prototypes -Wstrict-prototypes"
else
  WARNING_CFLAGS=
fi
UAE_CFLAGS="$OPTIMIZE_CFLAGS $WARNING_CFLAGS -DREGPARAM="
UAE_CXXFLAGS=" $OPTIMIZE_CFLAGS "

UAE_DEFINES="$UAE_DEFINES -D__USE_INLINE__"

# PPC-JIT
echo "checking whether to build PPC JIT compiler..."
if test "$WANT_JIT" != no; then
  echo "  yes"
  UAE_DEFINES="$UAE_DEFINES -DJIT"
  JITOBJS='compstbl.$(OBJEXT) compemu_macroblocks_ppc.$(OBJEXT) compemu_compiler_ppc.$(OBJEXT) compemu_support.$(OBJEXT)'
  echo "checking whether assembler supports --execstack option..."
  echo 'int main (void) { return 0; }' > conftest.c
  if try_compile "-Wa,--execstack"; then
    echo "  yes"
    UAE_CFLAGS="-Wa,--execstack $UAE_CFLAGS"
  else
    echo "  no"
  fi
  cleanup_conftest
else
  echo "  no"
fi

# Sound / GUI
echo "checking for sound target to build... "
if test "$WANT_AUDIO" != no; then
  echo "  native AmigaOS/AHI"
  UAE_DEFINES="$UAE_DEFINES -DDRIVESOUND"
  SND_DEP=sd-amigaos
else
  echo "  sound support disabled"
  SND_DEP=sd-none
fi

echo "checking which UI target to build..."
if test "$WANT_UI" = no; then
  GUI_DEP=gui-none
  echo "  none"
else
  GUI_DEP=gui-reaction
  GUI_NAME=ReAction
  if test "x$UAE_GUI_DEP" = "xgui-muirexx"; then
    GUI_DEP=gui-muirexx
    GUI_NAME=MUIRexx
  fi
  echo "  $GUI_NAME"
fi
if test ! -d src/$GUI_DEP; then
  echo "configure: error: Verzeichnis src/$GUI_DEP fehlt (ReAction-GUI nicht kopiert?)"
  exit 1
fi

# Chipsatz, Autoconfig, Dateisystem
if test "$WANT_AGA" != no; then
  UAE_DEFINES="$UAE_DEFINES -DAGA"
fi
if test "$WANT_AUTOCONFIG" != no; then
  UAE_DEFINES="$UAE_DEFINES -DAUTOCONFIG -DFILESYS"
  FILESYSOBJS='filesys.$(OBJEXT) fsdb.$(OBJEXT) fsusage.$(OBJEXT) hardfile.$(OBJEXT) filesys_unix.$(OBJEXT) fsdb_unix.$(OBJEXT) hardfile_unix.$(OBJEXT) filesys_cdfs.$(OBJEXT)'
fi

# CD-ROM-Laufwerke mit ISO-/CUE-Images ueber uaescsi.device (v16):
# scsiemul.c (Device), blkdev.c (Verteiler), blkdev-cdimage.c (Images).
# --disable-cdimage (oder --disable-scsi-device) schaltet es ab.
if test "$enable_scsi_device" = no; then
  WANT_CDIMAGE=no
fi
if test "$WANT_CDIMAGE" != no && test "$WANT_AUTOCONFIG" != no; then
  UAE_DEFINES="$UAE_DEFINES -DSCSIEMU"
  SCSIOBJS='scsiemul.$(OBJEXT) blkdev.$(OBJEXT) blkdev-cdimage.$(OBJEXT)'
fi

# CD32 (v17): Akiko chip (akiko.c, port of WinUAE) - needs AGA and the
# CD-ROM image drive. --disable-cd32 schaltet es ab.
echo "checking whether to build CD32 emulation..."
if test "$WANT_CD32" != no && test "$WANT_AGA" != no && test "$WANT_CDIMAGE" != no && test "$WANT_AUTOCONFIG" != no; then
  echo "  yes"
  UAE_DEFINES="$UAE_DEFINES -DCD32"
  CDOBJS='akiko.$(OBJEXT)'
else
  echo "  no"
  WANT_CD32=no
fi

# Threads (td-amigaos = native AmigaOS-Threads, kein pthread noetig)
UAE_DEFINES="$UAE_DEFINES -DSUPPORT_THREADS"

if test "$WANT_FDI" != no; then
  UAE_DEFINES="$UAE_DEFINES -DFDI2RAW"
fi
if test "$WANT_DEBUGGER" != no; then
  UAE_DEFINES="$UAE_DEFINES -DDEBUGGER"
  DEBUGOBJS='debug.$(OBJEXT) ppc_disasm.$(OBJEXT) identify.$(OBJEXT)'
fi
if test "$WANT_STATESAVING" != no; then
  UAE_DEFINES="$UAE_DEFINES -DSAVESTATE"
fi
if test "$WANT_ENFORCER" != no; then
  if test "$WANT_AUTOCONFIG" != no; then
    UAE_DEFINES="$UAE_DEFINES -DENFORCER"
  else
    echo "configure: WARNING: Autoconfig deaktiviert - Enforcer-Emulation entfaellt"
  fi
fi
if test "$WANT_ACTION_REPLAY" != no; then
  UAE_DEFINES="$UAE_DEFINES -DACTION_REPLAY"
fi
if test "$WANT_XARCADE" != no; then
  UAE_DEFINES="$UAE_DEFINES -DXARCADE"
fi

# bsdsocket.library-Emulation: bsdsocket.c (AmigaOS-4.1-Variante) ist ohne
# -DBSDSOCKET nicht uebersetzbar (#error). Host-Seite ist od-amiga/bsdsock.c,
# bsdsocket-posix-new.c wird auf AmigaOS NICHT gebraucht.
echo "checking whether to build bsdsocket.library emulation..."
if test "$WANT_BSDSOCK" != no && test "$WANT_AUTOCONFIG" != no; then
  UAE_DEFINES="$UAE_DEFINES -DBSDSOCKET"
  BSDSOCKOBJS='bsdsocket.$(OBJEXT)'
  echo "  yes"
else
  echo "  no"
  echo "configure: WARNING: ohne bsdsocket-Emulation baut bsdsocket.c nicht (#error)"
fi

# Joystick
