# ------------------------------------------------------------ Ausgabedateien
SUBST_VARS="CC CXX CPP CFLAGS CXXFLAGS CPPFLAGS LDFLAGS LIBS DEFS AR RANLIB STRIP \
 OBJEXT EXEEXT SHELL SET_MAKE MATHLIB UAE_CFLAGS UAE_CPPFLAGS UAE_CXXFLAGS UAE_LIBS \
 ac_cv_c_inline NO_SCHED_CFLAGS GENCPUOPTS TARGET MACHDEP OSDEP THREADDEP GFX_DEP \
 SND_DEP JOY_DEP GUI_DEP EXTRAOBJS CPUOBJS JITOBJS RESOBJS ASMOBJS SCSIOBJS CDOBJS \
