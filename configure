 target_os install_sh INSTALL INSTALL_PROGRAM INSTALL_SCRIPT INSTALL_DATA \
 INSTALL_STRIP_PROGRAM MKDIR_P mkdir_p AWK GREP EGREP ETAGS CTAGS CSCOPE CYGPATH_W \
 PATH_SEPARATOR program_transform_name AMDEP_TRUE AMDEP_FALSE AMDEPBACKSLASH \
 am__include am__quote am__nodep am__fastdepCC_TRUE am__fastdepCC_FALSE \
 am__fastdepCXX_TRUE am__fastdepCXX_FALSE am__fastdepOBJC_TRUE am__fastdepOBJC_FALSE \
 am__fastdepCCAS_TRUE am__fastdepCCAS_FALSE CCDEPMODE CXXDEPMODE OBJCDEPMODE \
 CCASDEPMODE DEPDIR am__leading_dot am__isrc AM_V AM_DEFAULT_V AM_DEFAULT_VERBOSITY \
 am__tar am__untar AMTAR ACLOCAL AUTOCONF AUTOMAKE AUTOHEADER MAKEINFO CCAS CCASFLAGS \
 OBJC OBJCFLAGS OBJC_LDFLAGS ac_ct_CC ac_ct_CXX ac_ct_OBJC LIBOBJS LTLIBOBJS \
 SDL_CONFIG SDL_CFLAGS SDL_LIBS GTK_CONFIG GTK_CFLAGS GTK_LIBS PKG_CONFIG PTHREAD_CC \
 PTHREAD_CFLAGS PTHREAD_LIBS XMKMF X_CFLAGS X_LIBS X_PRE_LIBS X_EXTRA_LIBS subdirs \
 prefix exec_prefix datarootdir bindir sbindir libexecdir datadir sysconfdir \
 sharedstatedir localstatedir runstatedir includedir oldincludedir docdir infodir \
 htmldir dvidir pdfdir psdir libdir localedir mandir ECHO_N ECHO_C ECHO_T \
 TARGET_BIGENDIAN_TRUE TARGET_BIGENDIAN_FALSE TARGET_BEOS_TRUE TARGET_BEOS_FALSE \
 TARGET_LINUX_TRUE TARGET_LINUX_FALSE TARGET_WIN32_TRUE TARGET_WIN32_FALSE \
 BUILD_MACOSX_BUNDLE_TRUE BUILD_MACOSX_BUNDLE_FALSE"

# sed-Skript fuer die @VAR@-Ersetzung bauen
rm -f config.sed
: > config.sed
for v in $SUBST_VARS
do
  eval "val=\$$v"
  esc=`echo "$val" | sed -e 's/\\\\/\\\\\\\\/g' -e 's/[&|]/\\\\&/g'`
  echo "s|@$v@|$esc|g" >> config.sed
done

# Liste der zu erzeugenden Dateien
